{
  "name": "@directdrop/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "verify:public": "node scripts/verify-public.mjs",
    "verify:browser-share": "node scripts/hold-browser-share.mjs"
  },
  "dependencies": {
    "@directdrop/protocol": "workspace:*",
    "@fastify/cors": "latest",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@node-rs/argon2": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/ws": "latest",
    "tsx": "latest",
    "vitest": "^4.1.10",
    "ws": "latest"
  }
}
